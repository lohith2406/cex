{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "jsx-a11y",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "ignorePatterns": [
    ".next/**",
    "next-env.d.ts",
    "src/components/ui/**"
  ]
}
